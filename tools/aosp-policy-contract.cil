(type dash_daemon_release_probe)
(typeattributeset domain (dash_daemon_release_probe))
(typeattributeset coredomain (dash_daemon_release_probe))
(typeattributeset mlstrustedsubject (dash_daemon_release_probe))
(typeattributeset dash_native_touch_access (dash_daemon_release_probe))

(type dash_app_release_probe)
(typeattributeset domain (dash_app_release_probe))
(typeattributeset coredomain (dash_app_release_probe))
(typeattributeset appdomain (dash_app_release_probe))
(typeattributeset untrusted_app_all (dash_app_release_probe))

(type dash_daemon_data_release_probe)
(typeattributeset file_type (dash_daemon_data_release_probe))
(typeattributeset data_file_type (dash_daemon_data_release_probe))
(typeattributeset core_data_file_type (dash_daemon_data_release_probe))

(type dash_mali_devfreq_release_probe)
(typeattributeset fs_type (dash_mali_devfreq_release_probe))
(typeattributeset sysfs_type (dash_mali_devfreq_release_probe))

(type dash_battery_supply_release_probe)
(typeattributeset fs_type (dash_battery_supply_release_probe))
(typeattributeset sysfs_type (dash_battery_supply_release_probe))

(type dash_sysfs_rw_release_probe)
(typeattributeset fs_type (dash_sysfs_rw_release_probe))
(typeattributeset sysfs_type (dash_sysfs_rw_release_probe))

(type dash_proc_rw_release_probe)
(typeattributeset fs_type (dash_proc_rw_release_probe))
(typeattributeset proc_type (dash_proc_rw_release_probe))

(type dash_swap_block_release_probe)
(typeattributeset dev_type (dash_swap_block_release_probe))

(type dash_input_device_release_probe)
(typeattributeset dev_type (dash_input_device_release_probe))

(type dash_touch_hal_release_probe)
(typeattributeset domain (dash_touch_hal_release_probe))
(typeattributeset halserverdomain (dash_touch_hal_release_probe))

(type dash_display_hal_release_probe)
(typeattributeset domain (dash_display_hal_release_probe))
(typeattributeset halserverdomain (dash_display_hal_release_probe))

(type dash_hal_service_release_probe)
(typeattributeset service_manager_type (dash_hal_service_release_probe))
(typeattributeset protected_service (dash_hal_service_release_probe))
(typeattributeset hal_service_type (dash_hal_service_release_probe))

(allow dash_daemon_release_probe self (capability
    (dac_override sys_admin sys_nice sys_ptrace)))
(allow dash_daemon_release_probe self (unix_stream_socket
    (create ioctl read getattr write setattr lock append bind connect listen
     accept getopt setopt shutdown map)))
(allow dash_daemon_release_probe self (netlink_kobject_uevent_socket
    (create bind read getattr getopt setopt)))

(allow dash_daemon_release_probe dash_daemon_data_release_probe
    (dir (add_name create getattr ioctl lock open read remove_name search
          setattr write)))
(allow dash_daemon_release_probe dash_daemon_data_release_probe
    (file (append create getattr ioctl lock map open read rename setattr unlink
           write)))

(allow dash_app_release_probe dash_daemon_release_probe
    (unix_stream_socket (connectto)))

(allow dash_daemon_release_probe sysfs (dir (search)))
(allow dash_daemon_release_probe dash_mali_devfreq_release_probe (dir (getattr search open read)))
(allow dash_daemon_release_probe dash_mali_devfreq_release_probe (file (getattr open read write ioctl lock map)))
(allow dash_daemon_release_probe dash_battery_supply_release_probe (file (getattr open read write ioctl lock map)))

(allow dash_daemon_release_probe dash_sysfs_rw_release_probe
    (dir (getattr open read search)))
(allow dash_daemon_release_probe dash_sysfs_rw_release_probe
    (file (getattr ioctl lock map open read write)))
(allow dash_daemon_release_probe dash_proc_rw_release_probe
    (file (getattr ioctl lock map open read write)))
(allow dash_daemon_release_probe dash_swap_block_release_probe
    (blk_file (getattr ioctl lock map open read write)))
(allow dash_daemon_release_probe dash_input_device_release_probe
    (chr_file (getattr ioctl lock map open read write)))

(allow dash_daemon_release_probe dash_touch_hal_release_probe
    (binder (call transfer)))
(allow dash_touch_hal_release_probe dash_daemon_release_probe
    (binder (transfer)))
(allow dash_daemon_release_probe dash_touch_hal_release_probe (fd (use)))
(allow dash_daemon_release_probe dash_touch_hal_release_probe (process (ptrace)))
(allow dash_daemon_release_probe dash_touch_hal_release_probe (dir (search)))
(allow dash_daemon_release_probe dash_touch_hal_release_probe (file (getattr open read write)))

(allow dash_daemon_release_probe dash_display_hal_release_probe
    (binder (call transfer)))
(allow dash_display_hal_release_probe dash_daemon_release_probe
    (binder (transfer)))
(allow dash_daemon_release_probe dash_display_hal_release_probe (fd (use)))
(allow dash_daemon_release_probe dash_hal_service_release_probe
    (service_manager (find)))

(allow dash_daemon_release_probe system_server (binder (call transfer)))
(allow system_server dash_daemon_release_probe (binder (transfer)))
(allow dash_daemon_release_probe system_server (fd (use)))
(allow system_server dash_daemon_release_probe (fd (use)))
(allow system_server dash_daemon_release_probe (fifo_file (write)))
(allow dash_daemon_release_probe display_service (service_manager (find)))
(allow dash_daemon_release_probe power_service (service_manager (find)))
(allow dash_daemon_release_probe settings_service (service_manager (find)))
(allow dash_daemon_release_probe window_service (service_manager (find)))
(allow dash_daemon_release_probe activity_service (service_manager (find)))
(allow dash_daemon_release_probe package_service (service_manager (find)))
(allow dash_daemon_release_probe logd (unix_stream_socket (connectto)))
(allow dash_daemon_release_probe logdr_socket (sock_file (write)))
(allow dash_daemon_release_probe overlay_service (service_manager (find)))
(allow dash_daemon_release_probe system_file
    (file (execute execute_no_trans getattr map open read)))
(allow dash_daemon_release_probe toolbox_exec
    (file (execute execute_no_trans getattr map open read)))
