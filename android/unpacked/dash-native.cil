; Dash Essential offline image integration. Merge into a loaded policy file.
; This fragment requires the Xiaomi Dash vendor labels; compile the full ROM.
(type dash_daemon)
(type dash_daemon_exec)
(type dash_daemon_data_file)
(type dash_app)
(type dash_app_userfaultfd)
(typeattribute dash_app_userfaultfd_others)
(typeattribute dash_app_ptrace_forbidden)
(type sysfs_dash_mali_devfreq)
(type sysfs_dash_touch)
(type sysfs_dash_subsystem)
(type sysfs_dash_subsystem_floor)
(roletype object_r dash_daemon)
(roletype object_r dash_daemon_exec)
(roletype object_r dash_daemon_data_file)
(roletype object_r dash_app)
(roletype object_r dash_app_userfaultfd)
(roletype object_r sysfs_dash_mali_devfreq)
(roletype object_r sysfs_dash_touch)
(roletype object_r sysfs_dash_subsystem)
(roletype object_r sysfs_dash_subsystem_floor)
(typeattributeset domain (dash_daemon dash_app))
(typeattributeset coredomain (dash_daemon dash_app))
(typeattributeset mlstrustedsubject (dash_daemon))
(typeattributeset appdomain (dash_app))
(typeattributeset untrusted_app_all (dash_app))
(typeattributeset netdomain (dash_app))
(typeattributeset exec_type (dash_daemon_exec))
(typeattributeset file_type (dash_daemon_exec dash_daemon_data_file))
(typeattributeset system_file_type (dash_daemon_exec))
(typeattributeset data_file_type (dash_daemon_data_file))
(typeattributeset core_data_file_type (dash_daemon_data_file))
(typeattributeset fs_type (sysfs_dash_mali_devfreq sysfs_dash_touch))
(typeattributeset sysfs_type (sysfs_dash_mali_devfreq sysfs_dash_touch))
(typeattributeset fs_type (sysfs_dash_subsystem sysfs_dash_subsystem_floor))
(typeattributeset sysfs_type (sysfs_dash_subsystem sysfs_dash_subsystem_floor))

; Equivalent app_domain essentials; Android's existing app rules still apply.
(typetransition dash_app tmpfs file appdomain_tmpfs)
(allow dash_app appdomain_tmpfs (file (execute getattr map read write ioctl)))
(allowx dash_app appdomain_tmpfs (ioctl file ((range 0x7701 0x770b))))
(typetransition dash_app dash_app anon_inode "[userfaultfd]" dash_app_userfaultfd)
(allow dash_app dash_app_userfaultfd (anon_inode (create ioctl read)))
(typeattributeset dash_app_userfaultfd_others (and (domain) (not (dash_app))))
(typeattributeset dash_app_ptrace_forbidden (and (domain) (not (dash_app crash_dump runas_app simpleperf))))
(neverallow dash_app_userfaultfd_others dash_app_userfaultfd (anon_inode (create ioctl read)))
(neverallow dash_app_ptrace_forbidden dash_app (process (ptrace)))

; Init startup, owned state and the certificate-bound app control socket.
(typetransition init dash_daemon_exec process dash_daemon)
(allow init dash_daemon (process (transition rlimitinh siginh)))
(allow init dash_daemon_exec (file (getattr open read execute map)))
(allow dash_daemon dash_daemon_exec (file (entrypoint getattr open read execute map)))
(allow dash_app dash_daemon (unix_stream_socket (connectto)))
(allow dash_daemon self (unix_stream_socket (ioctl read write create getattr setattr lock append bind connect listen accept getopt setopt shutdown)))
(allow dash_daemon self (capability (dac_override sys_admin sys_nice sys_ptrace)))
(allow dash_daemon self (netlink_kobject_uevent_socket (create bind read getattr getopt setopt)))
(allow dash_daemon dash_daemon_data_file (dir (ioctl read write create getattr setattr lock rename add_name remove_name reparent search open rmdir)))
(allow dash_daemon dash_daemon_data_file (file (ioctl read write create getattr setattr lock append map unlink link rename open)))

; Framework commands, including output pipe/FD replies.
(allow dash_daemon servicemanager (binder (call transfer)))
(allow servicemanager dash_daemon (binder (call transfer)))
(allow servicemanager dash_daemon (dir (search)))
(allow servicemanager dash_daemon (file (read open)))
(allow servicemanager dash_daemon (process (getattr)))
(allow dash_daemon system_server (binder (call transfer)))
(allow system_server dash_daemon (binder (transfer)))
(allow dash_daemon system_server (fd (use)))
(allow system_server dash_daemon (fd (use)))
(allow system_server dash_daemon (fifo_file (write)))
(allow dash_daemon display_service (service_manager (find)))
(allow dash_daemon power_service (service_manager (find)))
(allow dash_daemon settings_service (service_manager (find)))
(allow dash_daemon window_service (service_manager (find)))
(allow dash_daemon activity_service (service_manager (find)))
(allow dash_daemon package_service (service_manager (find)))
; Passive foreground event stream for Per-App Controls.
(allow dash_daemon logd (unix_stream_socket (connectto)))
(allow dash_daemon logdr_socket (sock_file (read write open getattr)))
(allow dash_daemon overlay_service (service_manager (find)))
(allow dash_daemon system_file (file (getattr open read execute map execute_no_trans)))
(allow dash_daemon toolbox_exec (file (getattr open read execute map execute_no_trans)))

; Hardware nodes. No generic sysfs file write permission.
(allow dash_daemon sysfs (dir (search)))
; Battery class links need parent traversal before leaf permissions apply.
; No sysfs_batteryinfo file access is granted.
(allow dash_daemon sysfs_batteryinfo (dir (search)))
(allow dash_daemon sysfs_devices_system_cpu (dir (search getattr open read)))
(allow dash_daemon sysfs_devices_system_cpu (file (read write getattr open ioctl lock map)))
(allow dash_daemon sysfs_devices_block (dir (search getattr open read)))
(allow dash_daemon sysfs_devices_block (file (read write getattr open ioctl lock map)))
(allow dash_daemon sysfs_memory (dir (search getattr open read)))
(allow dash_daemon sysfs_memory (file (read write getattr open ioctl lock map)))
(allow dash_daemon sysfs_ged (dir (search getattr open read)))
(allow dash_daemon sysfs_ged (file (read write getattr open ioctl lock map)))
(allow dash_daemon sysfs_mali_power_policy (dir (search getattr open read)))
(allow dash_daemon sysfs_mali_power_policy (file (read write getattr open ioctl lock map)))
(allow dash_daemon sysfs_therm (dir (search getattr open read)))
(allow dash_daemon sysfs_therm (file (read write getattr open ioctl lock map)))
(allow dash_daemon sysfs_usb_supply (dir (search getattr open read)))
(allow dash_daemon sysfs_usb_supply (file (read write getattr open ioctl lock map)))
(allow dash_daemon sysfs_battery_supply (dir (search getattr open read)))
(allow dash_daemon sysfs_battery_supply (file (read write getattr open ioctl lock map)))
(allow dash_daemon sysfs_zram (dir (search getattr open read)))
(allow dash_daemon sysfs_zram (file (read write getattr open ioctl lock map)))
(allow dash_daemon sysfs_fs_f2fs (dir (search getattr open read)))
(allow dash_daemon sysfs_fs_f2fs (file (read write getattr open ioctl lock map)))
(allow dash_daemon sysfs_blockio (dir (search getattr open read)))
(allow dash_daemon sysfs_blockio (file (read write getattr open ioctl lock map)))
; Screen-state detection has a framework power-service fallback. Do not grant
; coredomain access to generic LED files, forbidden by the stock platform.
(allow dash_daemon vendor_sysfs_displayfeature (dir (search getattr open read)))
(allow dash_daemon vendor_sysfs_displayfeature (file (read getattr open ioctl lock map)))
(allow dash_daemon proc_powerhal_cpu_ctrl (file (read write getattr open ioctl lock map)))
(allow dash_daemon proc_touch_boost (file (read write getattr open ioctl lock map)))
(allow dash_daemon proc_tp_file (file (read getattr open ioctl lock map)))
(allow dash_daemon proc_swappiness (file (read write getattr open ioctl lock map)))
(allow dash_daemon proc_drop_caches (file (write open getattr)))
(allow dash_daemon input_device (chr_file (read write getattr open ioctl lock map)))
(allow dash_daemon swap_block_device (blk_file (read write getattr open ioctl lock map)))
(allow dash_daemon sysfs_dash_mali_devfreq (dir (search getattr open read)))
(allow dash_daemon sysfs_dash_mali_devfreq (file (read write getattr open ioctl lock map)))
(allow dash_daemon sysfs_dash_touch (dir (search getattr open read)))
(allow dash_daemon sysfs_dash_touch (file (read write getattr open ioctl lock map)))
(genfscon sysfs "/devices/platform/soc/48000000.mali/devfreq/48000000.mali" (u object_r sysfs_dash_mali_devfreq ((s0) (s0))))
(genfscon sysfs "/devices/platform/48000000.mali/devfreq/48000000.mali" (u object_r sysfs_dash_mali_devfreq ((s0) (s0))))
(genfscon sysfs "/devices/platform/goodix_ts.0" (u object_r sysfs_dash_touch ((s0) (s0))))

; Subsystem metadata is read-only; requests are confined to min_freq/max_freq.
(allow dash_daemon sysfs_dash_subsystem (dir (search getattr open read)))
(allow dash_daemon sysfs_dash_subsystem (file (read getattr open)))
(allow dash_daemon sysfs_dash_subsystem_floor (file (read write getattr open)))
; Preserve the target ROM's RAM parent label and existing controller access.
(allow dash_daemon sysfs_dvfsrc_devfreq (dir (search getattr open read)))
(allow dash_daemon sysfs_dvfsrc_devfreq (file (read getattr open)))
(allow mtk_hal_power sysfs_dash_subsystem (dir (ioctl read getattr lock open watch watch_reads search)))
(allow mtk_hal_power sysfs_dash_subsystem (file (ioctl read write getattr lock append map open watch watch_reads)))
(allow mtk_hal_power sysfs_dash_subsystem_floor (file (ioctl read write getattr lock append map open watch watch_reads)))
(genfscon sysfs "/devices/platform/1c013000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/min_freq" (u object_r sysfs_dash_subsystem_floor ((s0) (s0))))
(genfscon sysfs "/devices/platform/1c013000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/max_freq" (u object_r sysfs_dash_subsystem_floor ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/16810000.ufshci/devfreq/16810000.ufshci" (u object_r sysfs_dash_subsystem ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/16810000.ufshci/devfreq/16810000.ufshci/min_freq" (u object_r sysfs_dash_subsystem_floor ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/16810000.ufshci/devfreq/16810000.ufshci/max_freq" (u object_r sysfs_dash_subsystem_floor ((s0) (s0))))

; Xiaomi vendor services and narrowly scoped native THP timing access.
(allow dash_daemon vendor_hal_displayfeature_xiaomi_service (service_manager (find)))
(allow dash_daemon vendor_hal_displayfeature_xiaomi_default (binder (call transfer)))
(allow vendor_hal_displayfeature_xiaomi_default dash_daemon (binder (transfer)))
(allow dash_daemon vendor_hal_displayfeature_xiaomi_default (fd (use)))
(allow dash_daemon hal_touchfeature_xiaomi_service (service_manager (find)))
(allow dash_daemon hal_touchfeature_xiaomi_default (binder (call transfer)))
(allow hal_touchfeature_xiaomi_default dash_daemon (binder (transfer)))
(allow dash_daemon hal_touchfeature_xiaomi_default (fd (use)))
(allow dash_daemon hal_touchfeature_xiaomi_default (process (ptrace)))
(allow dash_daemon hal_touchfeature_xiaomi_default (dir (search)))
(allow dash_daemon hal_touchfeature_xiaomi_default (file (getattr open read write)))
