# Baseline policy for the Dash vendor image. Verify the labels against the
# exact vendor build used by the ROM before shipping; OEM ports can rename
# individual types while exposing the same kernel nodes.

# CPU, UFS, GPU, GED, thermal, charging, touch, and ZRAM controls.
allow dash_daemon sysfs_devices_system_cpu:dir search;
allow dash_daemon sysfs_devices_system_cpu:file rw_file_perms;
allow dash_daemon sysfs_devices_block:dir search;
allow dash_daemon sysfs_devices_block:file rw_file_perms;
allow dash_daemon sysfs_memory:dir search;
allow dash_daemon sysfs_memory:file rw_file_perms;
allow dash_daemon sysfs_ged:dir search;
allow dash_daemon sysfs_ged:file rw_file_perms;
allow dash_daemon sysfs_mali_power_policy:file rw_file_perms;
allow dash_daemon sysfs_therm:file rw_file_perms;
# Battery/USB class links resolve through battery-manager/power_supply.
# Traverse the parent only; do not grant access to batteryinfo files.
allow dash_daemon sysfs_batteryinfo:dir search;
allow dash_daemon sysfs_battery_supply:dir search;
allow dash_daemon sysfs_usb_supply:dir search;
allow dash_daemon sysfs_usb_supply:file rw_file_perms;
allow dash_daemon sysfs_battery_supply:file rw_file_perms;
allow dash_daemon sysfs_zram:file rw_file_perms;
allow dash_daemon sysfs_fs_f2fs:file rw_file_perms;
allow dash_daemon sysfs_blockio:file rw_file_perms;
# Screen-state readback falls back to dumpsys power; generic LED file access
# is forbidden to this coredomain by the platform policy.
allow dash_daemon vendor_sysfs_displayfeature:file r_file_perms;
allow dash_daemon proc_powerhal_cpu_ctrl:file rw_file_perms;
allow dash_daemon proc_touch_boost:file rw_file_perms;
allow dash_daemon proc_tp_file:file r_file_perms;
allow dash_daemon proc_swappiness:file rw_file_perms;
allow dash_daemon proc_drop_caches:file w_file_perms;
allow dash_daemon input_device:chr_file rw_file_perms;
allow dash_daemon swap_block_device:blk_file rw_file_perms;

# These Dash nodes are generic sysfs in the stock vendor image. Relabel only
# their exact subtrees so the coredomain never receives generic sysfs access.
type sysfs_dash_mali_devfreq, fs_type, sysfs_type;
type sysfs_dash_touch, fs_type, sysfs_type;
type sysfs_dash_subsystem, fs_type, sysfs_type;
type sysfs_dash_subsystem_floor, fs_type, sysfs_type;
allow dash_daemon sysfs_dash_subsystem:dir r_dir_perms;
allow dash_daemon sysfs_dash_subsystem:file r_file_perms;
# Only supported devfreq floor requests are writable, not force/voltage nodes.
allow dash_daemon sysfs_dash_subsystem_floor:file rw_file_perms;
# Existing RAM devfreq metadata label must not be replaced or duplicated.
allow dash_daemon sysfs_dvfsrc_devfreq:dir r_dir_perms;
allow dash_daemon sysfs_dvfsrc_devfreq:file r_file_perms;
# Preserve OEM PowerHAL access on the newly labeled request files/UFS subtree.
# These grants belong to the existing controller, not to the Dash app.
allow mtk_hal_power sysfs_dash_subsystem:dir r_dir_perms;
allow mtk_hal_power sysfs_dash_subsystem:file rw_file_perms;
allow mtk_hal_power sysfs_dash_subsystem_floor:file rw_file_perms;

allow dash_daemon sysfs:dir search;
allow dash_daemon sysfs_dash_mali_devfreq:dir r_dir_perms;
allow dash_daemon sysfs_dash_mali_devfreq:file rw_file_perms;
allow dash_daemon sysfs_dash_touch:dir r_dir_perms;
allow dash_daemon sysfs_dash_touch:file rw_file_perms;

# Xiaomi display and touch AIDL services.
binder_call(dash_daemon, vendor_hal_displayfeature_xiaomi_default)
binder_call(dash_daemon, hal_touchfeature_xiaomi_default)
allow dash_daemon vendor_hal_displayfeature_xiaomi_service:service_manager find;
allow dash_daemon hal_touchfeature_xiaomi_service:service_manager find;

# Dash's vendor touch service keeps the selected native panel cadence in its
# private THP timing block. Restrict cross-process access to that one HAL so
# 240/480 Hz restoration works for both Goodix and FocalTech panel variants.
allow dash_daemon hal_touchfeature_xiaomi_default:process ptrace;
allow dash_daemon hal_touchfeature_xiaomi_default:dir search;
allow dash_daemon hal_touchfeature_xiaomi_default:file { getattr open read write };

# ROM-native 1000 Hz output opens the SELinux-labelled Dash input event
# directly. It does not inspect or trace the touch service process.
